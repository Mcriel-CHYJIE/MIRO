<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Detection" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- windowBackground 决定 enableEdgeToEdge 下状态栏区域的底色,需与顶栏 headerBg 一致 -->
    <style name="Theme.MIRO" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF252525</item>
    </style>
</resources>
